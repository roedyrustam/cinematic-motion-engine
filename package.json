{
  "name": "cinematic-motion-engine",
  "version": "3.0.0",
  "description": "Modular Broadcast Programmatic Motion Graphics Studio Suite, Kinetic Typography, WebGPU Shaders, Living Cartoon Stage, Whisper AI Lip-Sync, Procedural Foley & 60fps GPU-Accelerated Video Engine for AI Agents (Antigravity, Claude Code, Cursor, Codex, Windsurf)",
  "type": "module",
  "author": "Roedy Rustam",
  "license": "MIT",
  "homepage": "https://github.com/roedyrustam/cinematic-motion-engine#readme",
  "bugs": {
    "url": "https://github.com/roedyrustam/cinematic-motion-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roedyrustam/cinematic-motion-engine.git"
  },
  "keywords": [
    "motion-graphics",
    "programmatic-video",
    "kinetic-typography",
    "whisper-ai-sync",
    "procedural-foley",
    "sound-design",
    "gsap",
    "threejs",
    "webgpu",
    "wgsl-shaders",
    "svg-animation",
    "cartoon-rigging",
    "explainer-video",
    "ffmpeg",
    "puppeteer",
    "ai-agent-skill",
    "antigravity-plugin",
    "claude-code-skill",
    "cursor-rules",
    "broadcast-animation",
    "audio-reactive",
    "fft-visualizer",
    "nvenc-render"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "scaffold": "node scripts/scaffold-video.mjs",
    "snap": "node scripts/snap-contact-sheet.mjs",
    "export": "node scripts/export-video.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "analyze": "node scripts/analyze-audio.mjs",
    "foley": "node scripts/generate-foley.mjs",
    "whisper": "node scripts/sync-whisper.mjs",
    "audit": "node scripts/audit-anti-ppt.mjs assets --strict",
    "gallery": "node scripts/generate-gallery.mjs",
    "sync": "node scripts/sync-plugin.mjs",
    "sync:global": "node scripts/sync-plugin.mjs --global",
    "test": "node scripts/audit-anti-ppt.mjs assets --strict && node scripts/sync-plugin.mjs --check"
  },
  "optionalDependencies": {
    "puppeteer-core": "^24.43.1"
